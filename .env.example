# ─────────────────────────────────────────────────────────────────────────────
# W Héritage · variables des fonctions Vercel /api (anti-faux leads + code par texto)
# À saisir dans Vercel > Project > Settings > Environment Variables (Production + Preview).
# Rien ici n'est obligatoire : chaque service s'active seul quand sa clé existe.
# Pour tester en local : copier vers .env.local (ignoré par git) puis  node tools/dev-server.mjs
# ─────────────────────────────────────────────────────────────────────────────

# Twilio : Lookup v2 (type de ligne, statut, SMS pumping) + Verify (code à 6 chiffres)
# Console Twilio > Account Info. En production, préférez une clé API (SK…) : TWILIO_API_KEY + TWILIO_API_SECRET.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Verify > Services > Create « Walid Leads » (longueur du code 6, expiration 10 min, Fraud Guard activé)
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Champs Lookup. sim_swap, call_forwarding, reassigned_number exigent une approbation Twilio (CLNPC au Canada).
TWILIO_LOOKUP_FIELDS=line_type_intelligence,line_status,sms_pumping_risk
# 0 = ne pas faire de Lookup (économise 0,008 $ par lead)
TWILIO_LOOKUP=1
# 0 = accepter les numéros VoIP non fixes (Google Voice, TextNow). Défaut : bloqués.
TWILIO_BLOCK_VOIP=1

# Preuve signée (HMAC) que la feuille Google vérifie. Même valeur dans Apps Script > Propriétés du script.
# Générer :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_PROOF_SECRET=

# Cloudflare Turnstile (anti-robot invisible, gratuit). La clé de site va dans assets/site.js (turnstileSiteKey).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Validation SMTP du courriel (Abstract API, 100 gratuits / mois). Facultatif : MX + 10 000 domaines jetables déjà vérifiés.
ABSTRACT_EMAIL_KEY=

# VPN / proxy / Tor (IPQualityScore, 1 000 gratuits / mois). Facultatif.
IPQS_KEY=

# Limites de débit partagées entre les instances (Upstash Redis ou Vercel KV, offre gratuite suffisante).
# Sans ces clés, les limites existent par instance seulement (moins strictes).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Origines autorisées à appeler /api (protège le compte Twilio). Défaut : production + localhost.
ALLOWED_ORIGINS=https://wheritage.vercel.app,http://localhost
# 0 = refuser les aperçus Vercel (wheritage-xxxx.vercel.app)
ALLOW_PREVIEWS=1
